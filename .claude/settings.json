{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(cat *)",
      "Bash(lsof *)",
      "Bash(awk *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ],
    "deny": [
      "Read(.env*)",
      "Write(.env*)",
      "Read(**/.env*)",
      "Write(**/.env*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)"
    ],
    "ask": []
  }
}
